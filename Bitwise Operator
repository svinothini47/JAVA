public class Main
{
	public static void main(String[] args) {
	    int a=12;
	    int b=23;
	    System.out.println("a&b :"+(a&b));
	    System.out.println("a|b :"+(a|b));
	    System.out.println("a^b :"+(a^b));
	    System.out.println("~a :"+(~a));
	    System.out.println("a<<2 :"+(a<<2));
	    System.out.println("a>>1 :"+(a>>1));
	   
	}
}
