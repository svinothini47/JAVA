public class Main
{
	public static void main(String[] args) {
	    int n=128;
	    
	    if(n>0){
	        if (n%2==0){
	            System.out.println("Even Number");
	            
	        }
	        else {
		        System.out.println("Odd Number");
	        }
	    }
	    
	    else {
	        if(n==0){
	            System.out.println("Given Number is Zero");
	        }
	        else{
	            System.out.println("Given Number is Negative");
	        }
	   }
	}
}
